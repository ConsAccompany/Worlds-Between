def gates(r):
    hp, blobs, full, png, pxo, ora, pal = r
    g = M.gates(D, r)
    with zipfile.ZipFile(io.BytesIO(pxo)) as z:
        dj = z.read("data.json")
    g["pxo_labels_east"] = (b"heya-east" in dj and b"heya-south" not in dj and b"heya-west" not in dj
                            and b"heya-north" not in dj)
    g["pxo_no_foreign_metadata"] = all(s not in dj for s in (b"milo", b"jiang", b"lin-que", b"muxiu", b"yanke"))
    g["palette_fits_pxo_grid_40"] = len(PAL) <= 40
    al = full[..., 3]
    g["isolated_texels"] = WEST.isolated(full)
    g["isolated_texels_le_24"] = g["isolated_texels"] <= 24
    cols = lambda keys: {S.rgb(k) for k in keys}
    used = {tuple(c) for c in full[al == 255][:, :3]}
    g["identity_colours_visible"] = {"auburn_hair": bool(used & cols(("h1", "h2"))),
                                     "grey_white_scarf": bool(used & cols(("f1", "f2"))),
                                     "dark_red_bag": bool(used & cols(("b1", "b2"))),
                                     "ivory_coat": bool(used & cols(("w1", "w2"))),
                                     "pale_apron": bool(used & cols(("v1", "v2"))),
                                     "charcoal_dress": bool(used & cols(("c1", "c2"))),
                                     "leather": bool(used & cols(("r1", "r2"))),
                                     "brass": bool(used & cols(("y1", "y2"))),
                                     "herb_green": bool(used & cols(("n1", "n2")))}
    g["identity_colours_all"] = all(g["identity_colours_visible"].values())
    vis = g["visible_role_texels"]
    g["anchor_layers_visible"] = all(vis[n] >= 12 for n in ("braid", "scarf", "bag", "apron", "coat", "hair",
                                                           "face", "herb", "arms", "boots", "dress"))
    ys, xs = np.nonzero(al)
    g["silhouette_width"] = int(xs.max() - xs.min() + 1)
    g["silhouette_width_24_56"] = 24 <= g["silhouette_width"] <= 56
    g["profile_depth"] = g["silhouette_width"]
    g["profile_depth_20_34"] = 20 <= g["profile_depth"] <= 34

    # --- east profile direction: nose leads screen RIGHT, back of head is screen LEFT -------------
    face = blobs["face"]; fm = face[..., 3] == 255
    fy, fx = np.nonzero(fm)
    nose_rows = fm[24:28].any(axis=0); nose_x = int(np.nonzero(nose_rows)[0].max())
    back_rows = fm[17:22].any(axis=0); back_x = int(np.nonzero(back_rows)[0].min())
    g["profile_east_facing"] = nose_x >= 48 and back_x <= 35 and int(fx.min()) <= 35
    g["profile_east_facing_detail"] = {"nose_x": nose_x, "back_x": back_x}
    g["profile_face_narrow"] = int(fx.max() - fx.min() + 1) <= 20
    eye_white = np.zeros_like(fm)
    for yy in range(22, 27):
        for xx in range(40, 50):
            if fm[yy, xx] and (blobs["face"][yy, xx, :3] == S.rgb("e1")).all():
                eye_white[yy, xx] = True
    g["profile_one_eye"] = 1 <= int(eye_white.sum()) <= 8
    g["one_eye_detail"] = {"texels": int(eye_white.sum())}
    # mature 44-year-old: real cheek/jaw shading texels in the mid/lower face (not a smooth young mask)
    s3 = S.rgb("s3"); mature = 0
    for yy in range(25, 33):
        for xx in range(36, 50):
            if fm[yy, xx] and (blobs["face"][yy, xx, :3] == s3).all():
                mature += 1
    g["mature_face_shading"] = mature >= 10
    g["mature_face_detail"] = {"cheek_jaw_s3_texels": int(mature)}

    # low braided coil at the nape, behind/below the far ear at screen left; never a high bun
    bm = blobs["braid"][..., 3] == 255; by, bx = np.nonzero(bm)
    g["coil_low_at_nape_east"] = (int(bm.sum()) >= 80 and by.min() >= 23 and by.max() <= 40
                                  and float(bx.mean()) <= 37.0 and int(bx.min()) <= 30)
    g["coil_detail_east"] = {"texels": int(bm.sum()), "rows": [int(by.min()), int(by.max())],
                             "mean_x": round(float(bx.mean()), 2), "min_x": int(bx.min())}
    hm = blobs["hair"][..., 3] == 255; hy, _ = np.nonzero(hm)
    g["hair_not_high_bun_east"] = int(hy.max()) <= 30 and int(hy.min()) >= 8

    # scarf: wrap at the neck plus a long far-back tail; only cool grey-white colours
    sm = blobs["scarf"][..., 3] == 255; sy, sx = np.nonzero(sm)
    scols = {tuple(c) for c in blobs["scarf"][sm][:, :3]}
    g["scarf_east"] = (int(sm.sum()) >= 160 and int(sy.max()) >= 52 and int(sy.min()) <= 34
                       and scols <= cols(("f1", "f2", "f3")))
    g["scarf_detail_east"] = {"texels": int(sm.sum()), "rows": [int(sy.min()), int(sy.max())]}

    # bag: dark-red mass on the anatomical LEFT = FAR hip at screen left, partly exposed behind the back
    gm = blobs["bag"][..., 3] == 255; gy, gx = np.nonzero(gm)
    gcols = {tuple(c) for c in blobs["bag"][gm][:, :3]}
    brass = cols(("y1", "y2"))
    g["bag_left_hip_far_east"] = (int(gm.sum()) >= 80 and float(gx.mean()) <= 30.0 and int(gx.max()) <= 34
