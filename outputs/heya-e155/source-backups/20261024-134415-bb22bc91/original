                                  and int(gy.max() - gy.min() + 1) >= 12)
    g["bag_detail_east"] = {"texels": int(gm.sum()), "mean_x": round(float(gx.mean()), 2),
                            "x_range": [int(gx.min()), int(gx.max())], "rows": [int(gy.min()), int(gy.max())]}

    # restrained closed-lip smile at the front of the profile, no teeth
    mouth = np.zeros_like(fm)
    for yy in range(27, 32):
        for xx in range(42, 50):
            if fm[yy, xx] and (blobs["face"][yy, xx, :3] == S.rgb("m1")).all():
                mouth[yy, xx] = True
    my, mx = np.nonzero(mouth)
    teeth = any((blobs["face"][yy, xx, :3] == S.rgb("e1")).all()
                for yy in range(28, 31) for xx in range(42, 50) if fm[yy, xx])
    width = int(mx.max() - mx.min() + 1) if len(mx) else 0
    g["restrained_smile_east"] = (3 <= int(mouth.sum()) <= 6 and not teeth and width <= 4)
    g["mouth_detail_east"] = {"texels": int(mouth.sum()), "width": width, "teeth_visible": bool(teeth)}

    # genuine upper-left screen lighting: highlight texel centroids lie LEFT of their shadow colours.
    # A mirror of west would move h1/w1/s1 to screen right and fail these three comparisons.
    def mean_x_of(keys):
        m = np.zeros(al.shape, bool)
        for k in keys:
            m |= np.all(full[..., :3] == S.rgb(k), axis=2) & (al == 255)
        yy, xx = np.nonzero(m)
        return (round(float(xx.mean()), 2), int(m.sum())) if len(xx) else (None, 0)
    light = {"hair": [mean_x_of(("h1",)), mean_x_of(("h3",))],
             "coat": [mean_x_of(("w1",)), mean_x_of(("w3",))],
             "skin": [mean_x_of(("s1",)), mean_x_of(("s3",))]}
    g["upper_left_light_east"] = all(a[0] is not None and b[0] is not None and a[1] >= 20 and b[1] >= 20
                                     and a[0] < b[0] for a, b in light.values())
    g["upper_left_light_detail"] = light
    g["herb_visible_east"] = int((blobs["herb"][..., 3] == 255).sum()) >= 12
    # own silhouette: not a recolour of south/west/north, and not a horizontal mirror of west
    def alpha_arr(rel):
        import glob
        f = sorted(glob.glob(os.path.join(REPO, rel, "*static*.png")))
        return np.array(Image.open(f[0]).convert("RGBA"))[..., 3] > 0
    diffs = {k: int(np.count_nonzero(alpha_arr(v) != (al > 0)))
             for k, v in (("south", "game/assets/characters/heya-native-v01/south"),
                          ("west", "game/assets/characters/heya-native-v01/west"),
                          ("north", "game/assets/characters/heya-native-v01/north"))}
    g["own_silhouette_not_recolour"] = all(v >= 400 for v in diffs.values())
    g["silhouette_diff_detail"] = diffs
    g["not_mirrored_west"] = int(np.count_nonzero(np.fliplr(alpha_arr(
        "game/assets/characters/heya-native-v01/west")) != (al > 0))) >= 250
    g["not_mirrored_west_detail"] = int(np.count_nonzero(np.fliplr(alpha_arr(
        "game/assets/characters/heya-native-v01/west")) != (al > 0)))
    return g


HARD = M.HARD + ["pxo_labels_east", "pxo_no_foreign_metadata", "palette_fits_pxo_grid_40",
