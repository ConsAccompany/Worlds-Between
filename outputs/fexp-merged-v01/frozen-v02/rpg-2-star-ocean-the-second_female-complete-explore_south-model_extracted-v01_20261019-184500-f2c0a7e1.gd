			if settle_t < 0.0:
				settle_t = clock
				ev_t = clock
				if bob != 1:
					bob = 1
					bob_evt = clock
					hair_due = clock + float(st["stop_hair_lag_ms"])
				settle_log.append([clock, "origin", clock])
			else:
				_settle_events()
