					_land_contact(s, y, 0)
					landed_now = true
				else:
					_set_pose(f, prop[s]["pose"])
					f["seg"] = maxi(int(f["seg"]), 1 if int(prop[s]["u"]) >= 500 else 0)
					moving_feet += 1
		if moving_feet == 0 and not landed_now:
			var cand := ""
			for s in ["vl", "vr"]:
				if feet[s]["mode"] == "contact" and int(feet[s]["wo"]) != y:
					if cand == "" or int(feet[s]["wo"]) - y < int(feet[cand]["wo"]) - y:
						cand = s
