		for i in comps.size():
			if (comps[i] as Array).size() > (comps[big] as Array).size():
				big = i
		var dropped := 0
		for i in comps.size():
			var c: Array = comps[i]
			if i == big or c.size() > island_max:
				continue
			var all_leg := true
			for q in c:
				all_leg = all_leg and leg_pos.has(q)
			if all_leg:
				for q in c:
					img.set_pixelv(q, Color(0, 0, 0, 0))
				dropped += c.size()
		r["v10_leg_islands_dropped"] = dropped
		return r

